# Buildroot defconfig for the TI TMDSEVM3530 (OMAP35x EVM) Rev D - omap-ng
# Kernel and bootloader are NOT built here (scripts/build-kernel.sh, scripts/build-uboot.sh);
# their modules are copied in by post-build.sh from $OMAPNG_MODULES.

# ---- target: OMAP3530, Cortex-A8 with NEON, hard-float ----
BR2_arm=y
BR2_cortex_a8=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON=y

# ---- toolchain: Buildroot-built, glibc, C++ (also exported as the SDK) ----
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_6_18=y

# ---- system ----
BR2_TARGET_GENERIC_HOSTNAME="omap3evm"
BR2_TARGET_GENERIC_ISSUE="omap-ng - TMDSEVM3530 Rev D"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_TARGET_GENERIC_ROOT_PASSWD="omap-ng"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OMAPNG_PATH)/board/omap3evm-revd/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OMAPNG_PATH)/board/omap3evm-revd/post-build.sh"

# ---- packages ----
# needed to offer packages that BusyBox also provides (e.g. i2c-tools)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_LIBGPIOD2=y
BR2_PACKAGE_LIBGPIOD2_TOOLS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_SPI_TOOLS=y
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_HTOP=y

# ---- root filesystem image: ext4, written to SD partition 2 then grown ----
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_LABEL="rootfs"
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_TARGET_ROOTFS_TAR=y
