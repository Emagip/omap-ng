# SPDX-License-Identifier: GPL-2.0-only
# Kconfig fragment merged over omap2plus_defconfig by scripts/build-kernel.sh

# user-space GPIO / SPI access (GPIO_CDEV is default-y, made explicit)
CONFIG_GPIO_CDEV=y
CONFIG_SPI_SPIDEV=y

# on-board LED (TWL4030 LEDB) as a heartbeat, usable before any rootfs/modules
# (LEDS_GPIO=y needs the LED class built in: omap2plus_defconfig has it =m)
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y

# OneNAND on GPMC CS0 (already y in omap2plus_defconfig, made explicit)
CONFIG_MTD_ONENAND=y
CONFIG_MTD_ONENAND_OMAP2=y

# auto-mount devtmpfs on /dev
CONFIG_DEVTMPFS_MOUNT=y
