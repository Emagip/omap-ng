// SPDX-License-Identifier: GPL-2.0-only
/*
 * TI OMAP35x EVM (TMDSEVM3530), as found on this unit:
 *   - main board OMAP-EVM-MB-1518 Rev D ("Gen 1": LAN9115 Ethernet,
 *     no on-board EHCI host port: that port lived on the multimedia
 *     daughter card until Rev E)
 *   - processor module O3530-PB-1518 Rev B, OMAP3530 ES2.1,
 *     Samsung K5W1G1GACM PoP: 128 MB OneNAND (GPMC CS0) + 128 MB mDDR
 *   - no multimedia daughter card, no WL1271 module, touchscreen removed
 *
 * Built on top of the mainline omap3-evm.dts, which describes the later
 * Rev E/G boards with NAND processor modules.
 */

#include "omap3-evm.dts"

/ {
	model = "TI OMAP35XX EVM (TMDSEVM3530) Rev D, OneNAND";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		/* lets U-Boot pass its ethaddr (from the LAN9115 EEPROM) as local-mac-address */
		ethernet0 = "/ocp@68000000/gpmc@6e000000/ethernet@gpmc";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x08000000>;	/* 128 MB (U-Boot fixes this up too) */
	};

	leds {
		ledb {
			/* on the underside of the board: blinks while the kernel runs */
			linux,default-trigger = "heartbeat";
		};
	};
};

/* ---- GPMC CS0: Samsung OneNAND instead of the NAND of later modules ---- */
&gpmc {
	ranges = <0 0 0x30000000 0x1000000>,	/* CS0: 16MB for OneNAND */
		 <5 0 0x2c000000 0x01000000>;	/* CS5: 16MB for LAN9115 */

	/delete-node/ nand@0,0;

	onenand@0,0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "ti,omap2-onenand";
		reg = <0 0 0x20000>;		/* CS0, offset 0, IO size 128K */

		/* asynchronous timings from omap3430-sdp.dts (Samsung OneNAND, same SoC) */
		gpmc,device-width = <2>;
		gpmc,mux-add-data = <2>;
		gpmc,cs-on-ns = <0>;
		gpmc,cs-rd-off-ns = <84>;
		gpmc,cs-wr-off-ns = <72>;
		gpmc,adv-on-ns = <0>;
		gpmc,adv-rd-off-ns = <18>;
		gpmc,adv-wr-off-ns = <18>;
		gpmc,oe-on-ns = <30>;
		gpmc,oe-off-ns = <84>;
		gpmc,we-on-ns = <0>;
		gpmc,we-off-ns = <42>;
		gpmc,rd-cycle-ns = <108>;
		gpmc,wr-cycle-ns = <96>;
		gpmc,access-ns = <78>;
		gpmc,wr-data-mux-bus-ns = <30>;

		/*
		 * Layout used by the TI PSP 02.01.01.08 X-Loader/U-Boot still on
		 * the flash (board-omap3evm-flash.c). All read-only: the old
		 * firmware is the fallback boot when no SD card is inserted.
		 */
		partition@0 {
			label = "xloader-onenand";
			reg = <0x0 0x80000>;
			read-only;
		};
		partition@80000 {
			label = "uboot-onenand";
			reg = <0x80000 0x1e0000>;
			read-only;
		};
		partition@260000 {
			label = "params-onenand";
			reg = <0x260000 0x20000>;
			read-only;
		};
		partition@280000 {
			label = "linux-onenand";
			reg = <0x280000 0x500000>;
			read-only;
		};
		partition@780000 {
			label = "jffs2-onenand";
			reg = <0x780000 0x7880000>;
			read-only;
		};
	};
};

/*
 * ---- LAN9115 (Gen 1 main board) bus timings ----
 * omap-gpmc-smsc911x.dtsi is tuned for the LAN9220 of Rev E+ boards (155 ns cycles).
 * The LAN9115 needs a read/write cycle time of at least 165 ns (datasheet table 6-3);
 * out-of-spec access gave a silent smsc911x probe failure or a garbage MAC.
 * These are U-Boot's proven NET_GPMC_CONFIG2..5 tick counts for this board
 * (0x001e1e01 0x00080300 0x1c091c09 0x04181f1f), expressed in ns.
 *
 * The kernel converts ns to ticks with round-UP (L3 = 165 MHz -> 6060 ps/tick),
 * so each value is chosen just BELOW ticks * 6.06 ns. Rounding the other way
 * (188 ns for the 31-tick cycle) gave 32 ticks, overflowed the 5-bit
 * RDCYCLETIME/WRCYCLETIME fields and made gpmc refuse the child (-6, no eth0).
 * These values also give the same ticks at 166 MHz (6024 ps).
 */
&gpmc {
	ethernet@gpmc {
		gpmc,cs-on-ns = <6>;		/*  1 tick  */
		gpmc,cs-rd-off-ns = <180>;	/* 30 ticks */
		gpmc,cs-wr-off-ns = <180>;	/* 30 ticks */
		gpmc,adv-on-ns = <0>;		/*  0 ticks */
		gpmc,adv-rd-off-ns = <18>;	/*  3 ticks */
		gpmc,adv-wr-off-ns = <48>;	/*  8 ticks */
		gpmc,oe-on-ns = <54>;		/*  9 ticks */
		gpmc,oe-off-ns = <168>;		/* 28 ticks */
		gpmc,we-on-ns = <54>;		/*  9 ticks */
		gpmc,we-off-ns = <168>;		/* 28 ticks */
		gpmc,rd-cycle-ns = <186>;	/* 31 ticks = 188 ns > 165 ns min */
		gpmc,wr-cycle-ns = <186>;	/* 31 ticks */
		gpmc,access-ns = <144>;		/* 24 ticks */

		/*
		 * LAN9115 nRESET on Gen 1 boards: gpmc_wait2.gpio_64 (Gen 2: gpio_7),
		 * as in U-Boot's board/ti/omap3evm. smsc911x pulses it at probe
		 * (patches/linux/0003); U-Boot's own 1 us pulse is below spec.
		 */
		pinctrl-0 = <&smsc911x_pins &lan9115_rst_pins>;
		reset-gpios = <&gpio3 0 GPIO_ACTIVE_LOW>;	/* gpio_64 */
	};
};

/*
 * ---- On-die temperature sensor: disabled ----
 * ES2.1 parts have a non-trimmed bandgap sensor ("Temp not accurate"); a bogus
 * reading tripped the critical point 3.6 s after boot and powered the board off.
 */
&bandgap {
	status = "disabled";
};

&cpu_thermal {
	status = "disabled";
};

/* ---- USB host (EHCI) port 2: not present on Rev D without the daughter card ---- */
&usbhshost {
	status = "disabled";
};

/* no on-board EHCI PHY: its supply/reset GPIOs (gpio_22/gpio_21) are free */
&hsusb2_power {
	status = "disabled";
};

&hsusb2_phy {
	status = "disabled";
};

/* No WL1271 module: the WLAN supply regulator (gpio_150) is unused */
&wl12xx_vmmc {
	status = "disabled";
};

/* drop the Rev E+ USB host pinmux (frees mcspi1_cs3, McSPI2 and etk_d10..d15 pads) */
&omap3_pmx_core {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;

	led_test_pins: led-test-pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x2190, PIN_OUTPUT | MUX_MODE4)	/* mcbsp1_dx.gpio_158, P7 A18 */
		>;
	};

	lan9115_rst_pins: lan9115-rst-pins {
		pinctrl-single,pins = <
			OMAP3_CORE1_IOPAD(0x20d0, PIN_OUTPUT_PULLUP | MUX_MODE4)	/* gpmc_wait2.gpio_64, LAN9115 nRESET */
		>;
	};
};

&omap3_pmx_core2 {
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
};

/* drop the Rev E+ hogs that route gpio_61 to the on-board USB host bus switch */
&gpio2 {
	/delete-node/ en-usb2-port-hog;
};

&twl_gpio {
	/delete-node/ en-on-board-gpio-61-hog;
};

/* ---- No WL1271: MMC2 unused (frees the MMC2 pads on P7 A41-A49) ---- */
&mmc2 {
	status = "disabled";
};

/* ---- SD slot is 4-bit on this board ---- */
&mmc1 {
	bus-width = <4>;
};

/*
 * ---- TWL4030 power scripts: none ----
 * The mainline EVM DT uses "ti,twl4030-power-omap3-evm", which loads TI's OMAP3
 * idle sleep/wakeup scripts into the TWL4030 (all resources incl. VIO, CLKEN and
 * HFCLKOUT go to sleep when the OMAP signals idle). On this unit (Rev D main board,
 * T4030-PW-1518 power module) the TWL4030 then stops answering on I2C1 a few
 * seconds after boot ("timeout waiting on XUDF bit", twl -ETIMEDOUT), which takes
 * the VMMC1/VSIM regulators, the SD card and the LED down with it.
 * Plain "ti,twl4030-power" loads no scripts but keeps power-off support.
 */
&twl_power {
	compatible = "ti,twl4030-power";
};

/*
 * I2C1 to the TWL4030 at 400 kHz instead of 2.6 MHz HS mode: slowed down while
 * chasing the failure above. Not the cause, but a long multi-connector route,
 * and fast mode is plenty for PMIC register access.
 */
&i2c1 {
	clock-frequency = <400000>;
};

/* ---- No multimedia daughter card: no TVP5146 on I2C3 ---- */
&i2c3 {
	/delete-node/ tvp5146@5c;
};

/* ---- Touchscreen removed from the LCD panel on this unit ---- */
&mcspi1 {
	tsc2046@0 {
		status = "disabled";
	};
};

/* ---- First GPIO test: gpio_158 (P7 A18) muxed as GPIO, see GPIO-LED-TEST.md ---- */
&gpio5 {
	pinctrl-names = "default";
	pinctrl-0 = <&led_test_pins>;
};
